# Neon pooled connection string. Keep the ?sslmode=require parameter.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Upstash Redis TLS connection string.
REDIS_URL=rediss://default:replace-with-upstash-token@example.upstash.io:6379

